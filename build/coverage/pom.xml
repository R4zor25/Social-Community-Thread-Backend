<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>hu.bme.aut</groupId>
		<artifactId>social-community-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../parent/pom.xml</relativePath>
	</parent>
	<artifactId>coverage</artifactId>
	<packaging>pom</packaging>
	<name>coverage</name>
	<description>Aggregated JaCoCo report of every module's tests (target/site/jacoco-aggregate)</description>

	<dependencies>
		<dependency><groupId>hu.bme.aut</groupId><artifactId>events</artifactId></dependency>
		<dependency><groupId>hu.bme.aut</groupId><artifactId>common-web</artifactId></dependency>
		<dependency><groupId>hu.bme.aut</groupId><artifactId>user-projection</artifactId></dependency>
		<dependency><groupId>hu.bme.aut</groupId><artifactId>auth-service</artifactId><version>${project.version}</version></dependency>
		<dependency><groupId>hu.bme.aut</groupId><artifactId>gateway</artifactId><version>${project.version}</version></dependency>
		<dependency><groupId>hu.bme.aut</groupId><artifactId>thread-service</artifactId><version>${project.version}</version></dependency>
		<dependency><groupId>hu.bme.aut</groupId><artifactId>friend-service</artifactId><version>${project.version}</version></dependency>
		<dependency><groupId>hu.bme.aut</groupId><artifactId>chat-service</artifactId><version>${project.version}</version></dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>report-aggregate</id>
						<phase>verify</phase>
						<goals>
							<goal>report-aggregate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
