# Copy to .env and fill in real values. Never commit .env.

# Shared HMAC key for signing and validating JWTs (auth-service and api-gateway).
# Must be Base64 and decode to at least 32 bytes. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me

DB_USERNAME=postgres
DB_PASSWORD=change-me

# Only used when running a service outside Docker Compose; compose points the services at its own postgres.
DB_URL=jdbc:postgresql://localhost:5432/postgres
